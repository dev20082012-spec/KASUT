# Cloudinary Configuration
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Session Secret (any secure string)
SECRET=your_random_64_char_session_secret

# Database Option 1: MongoDB Atlas (Cloud)
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/KASUT?retryWrites=true&w=majority

# Database Option 2: Local MongoDB (Optional fallback)
MONGO_URL=mongodb://127.0.0.1:27017/KASUT
